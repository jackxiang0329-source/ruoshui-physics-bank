{
  "schema": "ruoshui-physics-zh-editorial-drafts/v1",
  "translation_language": "zh-CN",
  "status": "editor_first_pass_needs_independent_bilingual_review",
  "source": "Physics Refresher (CC BY 4.0)",
  "entries": [
    {
      "id": "PREF-00001",
      "source_sha256": "3b092ac0148d14207c8a86c29127b4d219705306bd2724110b8c19d3fcc1445f",
      "zh": "请自行各给出一个定性陈述和一个定量陈述（不要使用本节中的例子）。"
    },
    {
      "id": "PREF-00002",
      "source_sha256": "f96f3b55d5cd31e6451b3c9002f1a089507590f82c44141e6c890a92d655a3a4",
      "zh": "为什么科学理论被认为是可靠性较高的知识？"
    },
    {
      "id": "PREF-00003",
      "source_sha256": "1f3a31717f1678294b449f8fdbf4ca63e4a1868b38e483a93a6fc903eeae8860",
      "zh": "为什么不完美的模型在工程实践中仍可能被接受？"
    },
    {
      "id": "PREF-00004",
      "source_sha256": "6ccf30f1bc3121d30933317bdb2804834c3dec37d41fe906a236e854079c5e4d",
      "zh": "请区分假说（假设）与定律。"
    },
    {
      "id": "PREF-00005",
      "source_sha256": "93e8da5e728c295a67b0eac7895e3d015e404e2a574dcf69d08177b2e93db2c0",
      "zh": "工程师为什么需要定量模型？"
    },
    {
      "id": "PREF-00006",
      "source_sha256": "b28384f4b0c1e631ad38bbb5bb6ae24e84600c721baa1d88fd3a8a9127f70e92",
      "zh": "为什么科学方法没有一个最终的“结束”步骤？"
    },
    {
      "id": "PREF-00007",
      "source_sha256": "0268a4b6d1942d37bc826400a2c999b3f94735dccd41d63a67c40ade9a2a8cfe",
      "zh": "请自拟一个例子，说明没有单位的孤立数值为什么没有实际用处。"
    },
    {
      "id": "PREF-00008",
      "source_sha256": "2f109104c2d274e47151a4018dd34be5e7fac0db3f03e6fe4e3828183b178048",
      "zh": "什么是模型或理论的适用范围？"
    },
    {
      "id": "PREF-00009",
      "source_sha256": "beb15da6d26830eb15aa33df438832c38d17a9ff6dcd6cf2a20b898842088e0a",
      "zh": "请各举出一种适合使用简化模型和详细模型的情境（不要使用本节中的例子）。"
    },
    {
      "id": "PREF-00010",
      "source_sha256": "7bbff39f36a1514e3305fd95861ccaf6a42b8cfaf5aa39a2bc90455eb2c18316",
      "zh": "请用自己的话解释“$A$ 与 $B$ 成正比”是什么意思。"
    },
    {
      "id": "PREF-00011",
      "source_sha256": "42a4f76a5588d5050438e4f0f42105123a4ce069f80835787d9905eb2a85bc81",
      "zh": "某条走廊的测量结果记为“15”，但未注明单位。为什么暂时不能将它用于计算？"
    },
    {
      "id": "PREF-00012",
      "source_sha256": "ea9fa2db95d25eb567e28d0f0b4f6c9d51d764f9402696e289557bcbe6c718db",
      "zh": "一辆汽车的速率为 $30$ m/s。以 10 的幂表示，其最接近的数量级是多少？"
    },
    {
      "id": "PREF-00013",
      "source_sha256": "4deb2c6100072a5ca1f244529ede5df8ca8a55027f62651efdc0da54918f3411",
      "zh": "对一根弹簧施加 $15$ N 的力，弹簧伸长 $3$ cm。假设满足 $F=kx$，求弹簧劲度系数 $k$，单位用 N/cm 表示。"
    },
    {
      "id": "PREF-00014",
      "source_sha256": "0bd9faf8f33b735c808705d43ef7d1824d3b716e671d063d03aaed216b1e79e1",
      "zh": "利用上一题求得的劲度系数 $k$，求施加 $25$ N 的力时弹簧的伸长量。"
    },
    {
      "id": "PREF-00015",
      "source_sha256": "254ad901b38f4e474adba118011f6971efa13ff7814ed188418c234c3f1ad260",
      "zh": "计算得到雨滴的速率为 $200$ m/s，而雨滴的典型终端速率只有每秒几米。前者大约偏大了几个数量级？"
    },
    {
      "id": "PREF-00016",
      "source_sha256": "8d391256fb09d75adfa2b6c1c88cdab1142469bcc135f67133561153d2141e8f",
      "zh": "说明 $5$ kg 与 $5{,}000$ g 表示相同的质量。"
    },
    {
      "id": "PREF-00017",
      "source_sha256": "103cb8f54202468bd180e25183bee39d563ad001b0f804bb1827fd6899c36b27",
      "zh": "已知 $A=kB$，其中 $k=3$、$B=7$，求 $A$。"
    },
    {
      "id": "PREF-00018",
      "source_sha256": "c8c718c48044fe1a5353ab0362df8a5e88edda55a649ea6803ed4f0415785c38",
      "zh": "一块板长 $2$ m、宽 $0.5$ m。先估计其面积的数量级，再计算准确面积。"
    },
    {
      "id": "PREF-00019",
      "source_sha256": "ba0fbec9b40a629dd4cddad80d56e30616eb06e3f41a5b2f72926cb6d19b9431",
      "zh": "一座桥梁在荷载作用下的挠度被记录为“12”。为使这一测量结果完整，还必须补充什么？请举出两种可能的单位。"
    },
    {
      "id": "PREF-00020",
      "source_sha256": "1e4e7b8f5a99544b0c3432cb90b9a948519fc7b25bbe7a818f8577390e145b8d",
      "zh": "有人声称物体从 $5$ m 高处下落约需“1 s”。仅根据数量级估算，在地球表面附近这是否合理？"
    },
    {
      "id": "PREF-00021",
      "source_sha256": "1c98d6f05554c46ab086e9b7de0471ce64ffad406561039956127fbe42dbfff9",
      "zh": "请为一名跳伞者从开始下落到打开降落伞这一过程的持续时间，分别建立一个简化模型和一个详细模型。简化模型在什么条件下失效？"
    },
    {
      "id": "PREF-00022",
      "source_sha256": "b44979f3288de0a55275fc9b89d643b88360d2616573d081d6884fd2a29b9a89",
      "zh": "将“这根缆绳能承受很大的重量”改写成一项定量且可检验的陈述。"
    },
    {
      "id": "PREF-00023",
      "source_sha256": "f1edaa11744548d3249c5e52ee0a1cdfb98b03272cd7773a0ae8054d2b0c7c2f",
      "zh": "结合牛顿定律的适用范围，解释为什么尽管存在相对论，工程师仍广泛使用牛顿定律。"
    },
    {
      "id": "PREF-00024",
      "source_sha256": "b17f944ce43cf6d4019253571667414ac2ac504985c2c7f6e9da2383c09b224d",
      "zh": "有人说：“没有模型是完美的，因此物理学不值得信赖，不能用于设计。”请反驳这一观点。"
    },
    {
      "id": "PREF-00025",
      "source_sha256": "77a20e9248867781f671c962fe47009040754a78023b106fc0630131297329df",
      "zh": "进行两步数量级检验：一辆汽车在 $5$ s 内从静止加速到 $10^6$ m/s，这是否合理？"
    },
    {
      "id": "PREF-00026",
      "source_sha256": "0cc95df2c72c90487f31ab5528cd8bca98302dfa28fe56fc75c2acf536fe0d4c",
      "zh": "请用自己的话解释基本物理量与导出物理量的区别，并分别给出两个本节未使用过的例子。"
    },
    {
      "id": "PREF-00027",
      "source_sha256": "0238a624e5d49a55af669211c1465a61c7b935a1279ac2a4b68adf457322e921",
      "zh": "为什么国际单位制采用七个基本单位，而不是例如三个或二十个？"
    },
    {
      "id": "PREF-00028",
      "source_sha256": "30789250815099964774b6b7f483041f813d8854ff5202304dc2c3865cd0f36b",
      "zh": "为什么“毫”（milli）这样的单位词头本身不是一个单位？"
    },
    {
      "id": "PREF-00029",
      "source_sha256": "f9f1191a9a9c0f15de9314bf9075e1650e43955ca8f7d510c2a6cb34e3c75bff",
      "zh": "什么是方程的“量纲一致性”？为什么它是方程正确的必要条件，却不是充分条件？"
    },
    {
      "id": "PREF-00030",
      "source_sha256": "d6bb4311cbbfe2c611b998c557046172a1cacd52b01b10d411130115740fd86d",
      "zh": "为什么牛顿虽然有专门名称，仍属于导出单位？"
    },
    {
      "id": "PREF-00031",
      "source_sha256": "e89a8e25bf2d0c5887a9a56aa4ccd9526633f10a6a244f7347204989c12875d2",
      "zh": "假设只知道某个陌生物理量的定义式，请逐步说明如何确定它的国际单位制基本单位表达式。"
    },
    {
      "id": "PREF-00032",
      "source_sha256": "cfb35f4fe3b5073ce817d04019e8240a9e46a26a7e5224255d00065892df1992",
      "zh": "在单位换算中，为什么所用的每个换算因子在物理意义上都必须等于 1？"
    },
    {
      "id": "PREF-00033",
      "source_sha256": "6d54c27205239d721e68e853502202f6c1cf8124830c2bba559c418dd52feb9b",
      "zh": "请举出两个因量纲不同而不能直接相加的物理量，并解释原因。"
    },
    {
      "id": "PREF-00034",
      "source_sha256": "196eb676bd1f4892d6d59057afbf85ef1bb04ce3e28e31af666cc31ab3016816",
      "zh": "请结合“火星气候轨道器”（Mars Climate Orbiter）的案例，说明为什么在大型工程团队中，统一单位比个人独立工作时更加重要。"
    },
    {
      "id": "PREF-00035",
      "source_sha256": "328af4f1426e7f90d29ad375b522a13765159eeb282ba452622047a512a195dc",
      "zh": "相较于完整的科学记数法，用国际单位制词头表示极大或极小的数值有什么实际好处？"
    },
    {
      "id": "PREF-00036",
      "source_sha256": "a7ac3fcdf0f51c3c8bdcd2fc047af6925f19b002becfc681d52c49a6369cedc1",
      "zh": "将 $5.2$ km 换算为 m。"
    },
    {
      "id": "PREF-00037",
      "source_sha256": "d8967650b59d176e6b69bea19baa65721b7058811d91d4ff19540c4c6450dbec",
      "zh": "将 $250$ mg 换算为 kg，并用科学记数法表示结果。"
    },
    {
      "id": "PREF-00038",
      "source_sha256": "705e4f9257fb76f8d90df17cb90f577b9526359369f9f400731233629a6cb366",
      "zh": "某信号的周期为 $2.5$ μs。将其换算为秒，并用科学记数法表示。"
    },
    {
      "id": "PREF-00039",
      "source_sha256": "317449f53ee01ce4fe4aa0a860df97c5b727755df2e97e97229cd0b039ef0fbe",
      "zh": "已知动能公式 $E_k = \\tfrac{1}{2}mv^2$，其中 $m$ 为质量、$v$ 为速率，推导 $E_k$ 的国际单位制基本单位表达式。"
    },
    {
      "id": "PREF-00040",
      "source_sha256": "8618b22a188da26f9bc3f431e7fa0948aa31ee8d33f92fa9f0642f049a897fec",
      "zh": "已知电流公式 $I=q/t$，其中 $q$ 为电荷量（单位为库仑 C）、$t$ 为时间，求电流的国际单位制基本单位，并利用 $1\\text{ C}=1\\text{ A}\\cdot\\text{s}$ 验证其与安培的一致性。"
    },
    {
      "id": "PREF-00080",
      "source_sha256": "c85226f675c77062276ff0f9ab4e17e42452803f3aeebed2810a0295ba46fb11",
      "zh": "请从几何角度解释为什么矢量相加的首尾相接法能够得到正确的合矢量。"
    },
    {
      "id": "PREF-00151",
      "source_sha256": "bee04436216b78bbe0a8d87a68b706287d6ef2cfba99025d624ce0311ec026fe",
      "zh": "请解释平均速度与瞬时速度的区别。"
    },
    {
      "id": "PREF-00176",
      "source_sha256": "d2035afe9109be9293f6933a74b87699134daf25824f53b623ad75c707ebafa2",
      "zh": "请解释为什么绘制准确的受力分析图通常是求解力学问题最重要的步骤。"
    },
    {
      "id": "PREF-00201",
      "source_sha256": "6e406c951ebb9cdab596238cb51daa92ece45cfc822b5da9046b1cbb987f9f96",
      "zh": "功的定义涉及两个矢量，为什么功本身却是标量？"
    },
    {
      "id": "PREF-00226",
      "source_sha256": "74614fa1e7572d28cde1cfb7b1e5dbc57bf3c27509d63f5714639cc114a20d36",
      "zh": "为什么动能与速率的平方成正比，而不是与速率本身成正比？"
    },
    {
      "id": "PREF-00251",
      "source_sha256": "bd29e1a8316cd806bdf6898f2a36216e3aec82e24f82a4dc07ef800368c29b31",
      "zh": "为什么物体即使沿圆周以恒定速率运动，仍然具有加速度？"
    },
    {
      "id": "PREF-00276",
      "source_sha256": "b172aa54df8b66421e806de493348e826defb087cdfede90b2d405694989ae2d",
      "zh": "请用自己的话说明本节介绍的工程设计流程的五个阶段。"
    },
    {
      "id": "PREF-00301",
      "source_sha256": "533dedea006fb66de8eaa1b179da53a181718e6dd5755c749387969e25ac6cd0",
      "zh": "请解释为什么牛顿第二定律被称为第二模块的“核心”，而其他各节都与它相联系。"
    },
    {
      "id": "PREF-00326",
      "source_sha256": "e9ce8b6ac339fac6c5963b34e5a98a2a2f97a14821bd93e720cd64ae96e6ad65",
      "zh": "请解释电荷的“量子化”与“守恒”有何区别。"
    },
    {
      "id": "PREF-00351",
      "source_sha256": "57db508adc6112a48610a14c9a6481c80900f60a845d3a7e1ac621f62186a497",
      "zh": "为什么两个异种电荷之间的电势能为负，而两个同种电荷之间的电势能为正？"
    },
    {
      "id": "PREF-00376",
      "source_sha256": "bc092c014e581ceb8b53a50630196de3eb9da5541f988ee47fe156f800562307",
      "zh": "为什么金属导线中约定电流的方向与电子的实际运动方向相反？这一约定为什么不影响电路计算？"
    },
    {
      "id": "PREF-00401",
      "source_sha256": "fc8a29d3f44ff61232f5843b734ef60f60804d01385ce6a8fc61629cc9e89946",
      "zh": "为什么磁力只作用于运动电荷，而电场力也能作用于静止电荷？"
    },
    {
      "id": "PREF-00426",
      "source_sha256": "2430ebbb58de00841c189c433123369539101a0413d10413d66d2c928808e867",
      "zh": "请用自己的话解释电容这一物理量表示什么。"
    },
    {
      "id": "PREF-00451",
      "source_sha256": "0b22f408e741077466e884031340ee111ff12824c85f5faa40941c5d0a4460e8",
      "zh": "为什么把输电电压提高到原来的两倍，会使电阻损耗功率降至原来的四分之一，而不是二分之一？"
    },
    {
      "id": "PREF-00476",
      "source_sha256": "5d0a24eb037620ecac123c665adb87bc9a62929a0aed46daa6f0ccd9ddf2443d",
      "zh": "请解释为什么电荷被称为连接第三模块各概念的“核心节点”。"
    },
    {
      "id": "PREF-00501",
      "source_sha256": "b00171dca22be8265966b7baae45a6cfce202eed5865696e075539652570143c",
      "zh": "请结合漂浮的树叶这一例子（或自拟例子），解释为什么波被认为传递能量而不传递物质。"
    },
    {
      "id": "PREF-00526",
      "source_sha256": "13da3a4bb7a67eba050d2569d0b519654b808e685a6cf84d86f250a79003195e",
      "zh": "请用自己的话说明简谐运动必须满足的定义性条件。"
    },
    {
      "id": "PREF-00551",
      "source_sha256": "73d2e4793f24542907da8f58a0994a12a49257089184319f6ccd0b626ec54f06",
      "zh": "请从能量角度解释为什么实际振动系统在没有外部驱动力时最终会停止运动。"
    },
    {
      "id": "PREF-00576",
      "source_sha256": "832853652c7e11935bbcfce7931c70df3273bf2b805ac3bddd40ce54b4cb4c44",
      "zh": "请结合质量块—弹簧—耦合弹簧的例子，解释两个振子“耦合”是什么意思。"
    },
    {
      "id": "PREF-00601",
      "source_sha256": "6a08c5eb8b55b058ec95d032ad46268d9345251f6bf92c44acb01d7c3f0ba0e5",
      "zh": "请解释波数 $k$ 的物理意义，以及它与角频率 $\\omega$ 有何区别。"
    },
    {
      "id": "PREF-00626",
      "source_sha256": "20d79221ac812e7a6c09def50030d4c0fdd14f369474fdd6c5d9deeb0019f28e",
      "zh": "请解释两列相向传播的行波叠加后如何形成驻波。"
    },
    {
      "id": "PREF-00651",
      "source_sha256": "0d3b99193a3fb75cd9524489b59eb0460db84339a6dd0de6326d358e29ffb99b",
      "zh": "为什么分析房间声学特性时，可以采用与振动弦相同的数学方法？"
    },
    {
      "id": "PREF-00676",
      "source_sha256": "ff504e52c8052279d6b008f1ab0f4376511d40fd77383d3079230a81ccb6d4da",
      "zh": "请说明简谐运动的数学描述与第二模块第 2.5 节的圆周运动有怎样的联系。"
    },
    {
      "id": "PREF-00700",
      "source_sha256": "90dbd6e86dcfcb97a01112e557496e9d340011cfd60ad0d7ba3a48a99b5d3887",
      "zh": "请回顾整个课程：从第一模块（物理基础）、第二模块（力学）、第三模块（电磁学）各选择一个概念，并分别结合一个具体例子，说明它如何直接帮助你理解第四模块（波动）中的某一特定概念。这是一道综合探究题，没有唯一正确答案，但解释必须引用各模块中的具体公式或思想。"
    }
  ]
}
